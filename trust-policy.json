{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::798299234472:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
        },
        "StringLike": {
          "token.actions.githubusercontent.com:sub": [
            "repo:VOISAwareness/security-awareness-platform:*",
            "repo:VOISAwareness@*/security-awareness-platform@*:*",
            "repo:VOISAwareness*security-awareness-platform*:*",
            "repo:satyajit1106/security-awareness-platform:*",
            "repo:satyajit1106@*/security-awareness-platform@*:*",
            "repo:satyajit1106*security-awareness-platform*:*"
          ]
        }
      }
    }
  ]
}