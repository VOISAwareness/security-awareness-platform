// CloudFront viewer-request function (cloudfront-js-2.0) for the default
// behaviour of the distribution in scorm_cdn.tf. A Terraform template: the
// allowed address ranges are written in at apply time (app_hosting.tf).
//
// /scorm/<32 hex upload id>/<path>  ->  /training-content/<id>/<path>
// /media/<32 hex upload id>/<name>   ->  /public-media/<id>/<name>
//   (pictures in emails and browser pages; one flat, safe file name)
// Open to everyone (courses and emails need them). Anything else under
// /scorm/ or /media/, or a path that tries to climb out with "..", is 404,
// so no other key in the bucket can be asked for through CloudFront.
//
// Every other path is the app (app/ in the bucket), for viewers whose IPv4
// address is in ALLOWED only; anyone else gets 403. A file of the build
// (/assets/<file>, or a file at the top such as /favicon.svg) is served as
// itself; any other path is a page of the app, so it gets /app/index.html and
// the app's router shows the page.
var ALLOWED = ${allowed_cidrs};
var SCORM = /^\/scorm\/([0-9a-f]{32})\/(.+)$/;
var MEDIA = /^\/media\/([0-9a-f]{32})\/([A-Za-z0-9._-]{1,120})$/;
var APP_FILE = /^\/(assets\/[A-Za-z0-9._-]{1,200}|[A-Za-z0-9_-][A-Za-z0-9._-]{0,100}\.[A-Za-z0-9]{1,10})$/;
var CLIMB = /(^|\/)(\.|%2e){2}(\/|$)/i;

function ipv4(text) {
  var parts = String(text || '').split('.');
  if (parts.length !== 4) return null;
  var n = 0;
  for (var i = 0; i < 4; i++) {
    if (!/^[0-9]{1,3}$/.test(parts[i])) return null;
    var x = Number(parts[i]);
    if (x > 255) return null;
    n = n * 256 + x;
  }
  return n;
}

function isAllowed(ip) {
  var n = ipv4(ip);
  if (n === null) return false;
  for (var i = 0; i < ALLOWED.length; i++) {
    var cidr = ALLOWED[i].split('/');
    var base = ipv4(cidr[0]);
    var size = Math.pow(2, 32 - Number(cidr[1]));
    if (base !== null && Math.floor(n / size) === Math.floor(base / size)) return true;
  }
  return false;
}

function handler(event) {
  var request = event.request;
  var uri = request.uri;
  var media = uri.match(MEDIA);
  if (media && !/^\.+$/.test(media[2])) {
    request.uri = '/public-media/' + media[1] + '/' + media[2];
    return request;
  }
  if (uri.indexOf('/scorm/') === 0 || uri.indexOf('/media/') === 0) {
    var m = uri.match(SCORM);
    if (!m || CLIMB.test(m[2])) {
      return { statusCode: 404, statusDescription: 'Not Found' };
    }
    request.uri = '/training-content/' + m[1] + '/' + m[2];
    return request;
  }
  if (!isAllowed(event.viewer && event.viewer.ip)) {
    return {
      statusCode: 403,
      statusDescription: 'Forbidden',
      headers: { 'content-type': { value: 'text/plain; charset=utf-8' }, 'cache-control': { value: 'no-store' } },
      body: { encoding: 'text', data: 'VOIS Shield is only available from the allowed network.' },
    };
  }
  request.uri = APP_FILE.test(uri) && !CLIMB.test(uri) ? '/app' + uri : '/app/index.html';
  return request;
}
