<file path="src/App.jsx">
import React from 'react';
import { BrowserRouter as Router, Routes, Route, Navigate } from 'react-router-dom';
import { UserTypeProvider, useUserType } from './UserTypeContext/UserTypeContext';

import Layout from './GlobalComponents/Layout';
import LandingPage from './Pages/LandingPage/LandingPage';
import HomeScreen from './Pages/HomeScreen/HomeScreen';

const ProtectedRoute = ({ children, requiredScreen }) => {
  const { user, hasAccess } = useUserType();
  if (!user) return <Navigate to="/" replace />;
  if (requiredScreen && !hasAccess(requiredScreen)) {
    return <div className="p-10 text-red-500 font-bold">Access Denied.</div>;
  }
  return children;
};

function App() {
  return (
    <UserTypeProvider>
      <Router>
        <Routes>
          <Route path="/" element={<LandingPage />} />

          <Route element={<ProtectedRoute><Layout /></ProtectedRoute>}>
            {/* Restored the /home route so the login button works! */}
            <Route path="/home" element={<HomeScreen />} />
            
            {/* Placeholder routes to prevent crashes if you click the sidebar */}
            <Route path="/start-campaign" element={<div className="p-10 text-slate-900 dark:text-white">Start Campaign (Coming Soon)</div>} />
            <Route path="/create-scenario" element={<div className="p-10 text-slate-900 dark:text-white">Create Scenario (Coming Soon)</div>} />
            <Route path="/analytics" element={<div className="p-10 text-slate-900 dark:text-white">Analytics (Coming Soon)</div>} />
          </Route>
        </Routes>
      </Router>
    </UserTypeProvider>
  );
}

export default App;
</file>

