# `npm run start:built` (vite build --mode built): the built app on this
# computer. It calls the API at /api, which `vite preview` forwards like the
# dev server does (vite.config.js), so it works from http://localhost:5174
# (a port the API's and the bucket's CORS lists already allow, for uploads).
VITE_API_BASE_URL=/api
